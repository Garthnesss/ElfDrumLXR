 //-----------------------------------------------------------------------
+// Phase 4 stem capture (ElfDrumLXR patch 04): record voice `voice`'s stereo
+// contribution exactly as mixer_addDataToOutput() distributes it, BEFORE the
+// destination sum saturates and before any FX processing. Stereo and FX-bus
+// destinations contribute the panned pair (int16)(data*panL), (int16)(data*panR);
+// the mono destinations contribute the full signal on their channel and silence
+// on the other. The destination goes through the same jack-availability remap
+// as the add, so the channel shape matches what was actually distributed.
+// A stem is the voice's own post-fader, post-pan signal: stems do NOT sum to
+// the main buses when the FX bus is active (mains carry the wet result, stems
+// the dry contribution) or when several voices share a destination (the mains
+// saturate per sample, the stems do not).
+static void mixer_captureStem(uint8_t voice, uint8_t dest, const float panL, const float panR, int16_t* data)
+{
+	int16_t* stem = mixer_stemData[voice];
+	uint8_t i;
+	dest = mixer_checkOutJackAvailable(dest);
+	switch (dest)
+	{
+	case MIXER_ROUTING_DAC1_L:
+	case MIXER_ROUTING_DAC2_L:
+		for (i = 0; i < OUTPUT_DMA_SIZE; i++) { stem[2*i] = data[i]; stem[2*i+1] = 0; }
+		break;
+	case MIXER_ROUTING_DAC1_R:
+	case MIXER_ROUTING_DAC2_R:
+		for (i = 0; i < OUTPUT_DMA_SIZE; i++) { stem[2*i] = 0; stem[2*i+1] = data[i]; }
+		break;
+	default: /* MIXER_ROUTING_DAC1_STEREO, MIXER_ROUTING_DAC2_STEREO, MIXER_ROUTING_FX_BUS */
+		for (i = 0; i < OUTPUT_DMA_SIZE; i++) { stem[2*i] = (int16_t)(data[i] * panL); stem[2*i+1] = (int16_t)(data[i] * panR); }
+		break;
+	}
+}
+
